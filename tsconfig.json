{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["webxr"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@nswp/core": ["./vendor/nswp/types/index.d.ts"],
      "nswp-sdk/three": ["./vendor/nswp/sdk-types/three.d.ts"],
      "bitfeed": ["./src/types/bitfeed.d.ts"]
    }
  },
  "include": ["src", "test"]
}
